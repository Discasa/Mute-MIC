<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Mute MIC Installer</AssemblyName>
    <RootNamespace>MuteMIC.Installer</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.2.0</Version>
    <Product>Mute MIC Installer</Product>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Payload\*.*" LogicalName="Payload.%(Filename)%(Extension)" Condition="Exists('Payload')" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\SetupUi\SetupControls.cs" Link="SetupControls.cs" />
    <Compile Include="..\SetupUi\SetupStrings.cs" Link="SetupStrings.cs" />
  </ItemGroup>

</Project>
