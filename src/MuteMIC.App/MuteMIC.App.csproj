<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Mute MIC</AssemblyName>
    <RootNamespace>MuteMIC.App</RootNamespace>
    <ApplicationIcon>Assets\Icons\app.ico</ApplicationIcon>
    <Version>1.2.2</Version>
    <Authors>anderson</Authors>
    <Product>Mute MIC</Product>
    <Description>Tray utility that mutes all active Windows audio input devices at once.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Audio\*.wav" LogicalName="Audio.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Icons\*.ico" LogicalName="Icons.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
